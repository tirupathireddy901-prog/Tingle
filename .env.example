# Copy this file to .env and fill in local values.
# Never commit the real .env file.

# ---- General ----
NODE_ENV=development
APP_NAME=Tingle
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5175

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tingle
POSTGRES_USER=tingle_app
POSTGRES_PASSWORD=change_me_locally
DATABASE_URL=postgresql://tingle_app:change_me_locally@postgres:5432/tingle

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---- API service ----
API_PORT=4000
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# ---- Signaling service ----
SIGNALING_PORT=4100

# ---- coturn (self-hosted TURN) ----
TURN_REALM=tingle.local
TURN_HOST=localhost
TURN_LISTEN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_STATIC_AUTH_SECRET=change_me_turn_secret
# Public STUN is free and requires no self-hosting:
STUN_URLS=stun:stun.l.google.com:19302

# ---- Email (for verification / password reset) ----
# Use any SMTP-compatible free/self-hosted option in development
# (e.g. Mailhog/Mailpit). Never hardcode provider credentials here.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="Tingle <no-reply@tingle.local>"

# ---- Admin app ----
VITE_API_URL=http://localhost:4000

# ---- Feature flags ----
ENABLE_REGION_MATCHING=true
ENABLE_ANALYTICS=false
